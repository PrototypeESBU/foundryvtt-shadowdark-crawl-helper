<div class="combatant {{styleClass}}" style="order: {{order}}" data-combatant-id="{{id}}" data-is-owner="{{isOwner}}">
    <div class="frame">
        <div class="name">
            {{#if hideName}}
                ? ? ? ?
            {{else}}
                {{name}}
            {{/if}}
        </div>
        <div class="portrait">
            <img src="{{img}}" data-actor-id="{{actorId}}" data-combatant-id="{{id}}">
            {{#if initiativeSet}}
                <div class="initiative">{{initiative}}</div>
            {{/if}}
            
            <div class="overlay {{#unless overlay}}hidden{{/unless}}">
                {{#ifEq overlay "initiative"}}
                    {{#if isOwner}}
                        <a 
                            data-action="rollInitiative" 
                            data-combatant-id="{{id}}"
                            data-tooltip="Roll Initiative"
                        ><i class="fal fa-dice-d20"></i></a>
                    {{else}}
                        <i class="fal fa-dice-d20 faded"></i>
                    {{/if}}
                {{/ifEq}}
                {{#ifEq overlay "hidden"}}
                    <i class="fas fa-eye-slash faded"></i>
                {{/ifEq}}
                {{#ifEq overlay "defeated"}}
                    <i class="fas fa-skull faded"></i>
                {{/ifEq}}
                {{#unless overlay}}
                    <a 
                        data-action="nextTurn" 
                        data-combatant-id="{{id}}"
                        data-tooltip="End Turn"
                    ><i class="fas fa-angle-right"></i></a>
                {{/unless}}
            </div>

        </div>
        <div class="health-bar">
            <div 
                class="{{system.type}}" 
                style="width:{{barPercent}}%"
            >
            </div>
        </div>
        {{#if canView}}
            <div class="menu">
                {{#if hp}}
                    <div class="hp-wrapper">
                        <input type="text" class="current-health" data-value="{{hp.value}}" data-combatant-id="{{id}}"
                                value="{{hp.value}}" />
                        <span>/</span> 
                        <span>{{hp.max}}</span>
                    </div>
                {{/if}}
                {{#if ac}}<div style="font-size:10px">AC {{ac}}</div>{{/if}}
                {{#if level}}<div style="font-size:10px">Level {{level}}</div>{{/if}}
            </div>
        {{/if}}
    </div>
</div> 