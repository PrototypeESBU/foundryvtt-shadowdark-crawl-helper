<div class="gm-tools">
    <div class="heading">
        <a data-action="collapseGmTools">
            <i class="fa-solid fa-book-open-reader"></i>
            <span>{{localize "CRAWLHELPER.gmtools.title"}}</span>
            <i id="arrow" class="players-mode fas fa-angle-down"></i>
        </a>
    </div>
    <div class="content" data-drop="true">
        <div class="tools">
            <a data-action="toggleParty" data-tooltip="CRAWLHELPER.gmtools.tooltip-add-party"><i class="fas fa-people-group"></i></a>
            <a data-action="toggleGameMaster" data-tooltip="CRAWLHELPER.gmtools.tooltip-add-gm"><i class="fas fa-hat-wizard"></i></a>
            <a data-action="triggerEncounterCheck" data-tooltip="CRAWLHELPER.gmtools.tooltip-encounter-check"><i class="fa-solid fa-dice"></i></a>
            <a data-action="triggerEncounter" data-tooltip="CRAWLHELPER.gmtools.tooltip-encounter"><i class="fa-solid fa-bolt-lightning"></i></a>
            <a data-action="moralCheck" data-tooltip="CRAWLHELPER.gmtools.tooltip-moral-check" style="color: grey; cursor: not-allowed"><i class="fa-solid fa-person-running"></i></a>
            <a data-action="timePasses" data-tooltip="CRAWLHELPER.gmtools.tooltip-time-passes" style="color: grey; cursor: not-allowed"><i class="fa-solid fa-hourglass-half"></i></a>
            <a data-action="openCombatTracker" data-tooltip="CRAWLHELPER.gmtools.tooltip-open-combat"><i class="fa-solid fa-swords"></i></a>
            <a data-action="openSettingsMenu" data-tooltip="CRAWLHELPER.gmtools.tooltip-open-settings"><i class="fa-solid fa-gears"></i></a>
            <span></span>
            <a data-action="endCrawling" data-tooltip="CRAWLHELPER.gmtools.tooltip-end-tracker"><i class="fas fa-rectangle-xmark"></i></a>
        </div>
        <div class="danger">
            <div class="section">
                <label style="line-height: 2;">{{localize "CRAWLHELPER.danger.level"}}:</label>
                <select name="dangerLevel">
                    {{selectOptions dangerIndex selected=dangerLevel}}
                </select>
            </div>
            <div class="section">
                <label>{{localize "CRAWLHELPER.gmtools.table"}}:</label> 
                {{#if encounterTable}}
                    <a data-action="clearRollTable" data-tooltip="CRAWLHELPER.gmtools.table-remove" style="text-align: right;"><i class="fa-solid fa-trash"></i></a>
                    <a data-link data-uuid="{{encounterTable.uuid}}" style="grid-column: 1 / span 2;">{{encounterTable.name}}</a>
                {{else}}
                    <fieldset style="grid-column: 1 / span 2;">
                        <span>{{localize "CRAWLHELPER.gmtools.drop"}}</span>
                    </fieldset>
                {{/if}}
            </div>
        </div>
    </div>
</div>