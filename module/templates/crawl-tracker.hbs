<div class="main-part">
    {{#if started}}
        <div class="heading">
            <i class="fas fa-dungeon {{#if inCombat}}faded{{/if}}"></i>
            <h2>
                {{#if isGM}}
                    <a data-action="toggleCombat">{{mode}}</a>
                {{else}}
                    {{mode}}
                {{/if}}
            </h2>
            <i class="fas fa-swords {{#unless inCombat}}faded{{/unless}}"></i>
        </div>
        <div class="content">
            <span style="float:left"><h3>{{localize "CRAWLHELPER.round"}} {{round}}</h3></span>
            <span style="float:right">
                {{#unless inCombat}}
                    <i class="fas fa-dice" data-tooltip="CRAWLHELPER.gmtools.tooltip-encounter-check"></i> 
                    {{nextEncounter}}
                {{/unless}}
            </span>
        </div>
    {{else if isGM}}
        <div class="stub">
            <a data-action="startCrawling" data-tooltip="CRAWLHELPER.start-crawling"><i class="fas fa-dungeon"></i></a>
        </div>
    {{/if}}
</div>