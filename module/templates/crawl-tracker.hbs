<div class="main-part">
    {{#if started}}
        <div class="heading">
            {{#if inCombat}}
                <i class="fas fa-swords"></i>
            {{else}}
                <i class="fas fa-dungeon"></i>
            {{/if}}
            <h2>
                {{#if isGM}}
                    <a data-action="toggleCombat">{{mode}}</a>
                {{else}}
                    {{mode}}
                {{/if}}
            </h2>
        </div>
        <div class="content">
            <span style="float:left"><h3>{{localize "CRAWLHELPER.round"}} {{round}}</h3></span>
            <span style="float:right">
                {{#unless inCombat}}
                    <h3 style="color:grey">{{nextEncounter}}</h3>
                {{/unless}}
            </span>
        </div>
    {{/if}}
</div>