<div class="main-part">
{{#if crawlStarted}}

    <div class="side-buttons faded-ui" style="align-items:end">
        <button 
            class="ui-control icon fas fa-dice-d20 {{#unless unrolledInit}}unavailable{{/unless}}"
            id="rollAllInit"
            data-action="rollAllInit" 
            data-tooltip="CRAWLHELPER.carousel.roll-all">
        </button>
        {{#if isGM}}
            <button 
                class="ui-control icon fas fa-angles-right" 
                data-action="nextRound"
                data-tooltip="CRAWLHELPER.carousel.round.next">
            </button>
        {{/if}}
        <button 
            class="ui-control icon fas fa-angle-right {{#unless isGM}}unavailable{{/unless}}"
            id="nextTurn" 
            data-action="nextTurn"
            data-tooltip="CRAWLHELPER.carousel.turn.next">
        </button>
    </div>

    <div class="combatant-container shadowdark" style="{{containerStyle}}">
        {{#each combatants}}
            {{#if isDivider}}
                <div class="round-divider" style="order: {{order}}" data-combatant-id="{{id}}">
                    <div></div>
                    <span class="transition">{{round}}</span>
                    <div></div>
                </div>
            {{else}}
                    {{> combatant isGM=../isGM}}
            {{/if}}
        {{/each}}
    </div>

    {{#if isGM}}
        <div class="side-buttons faded-ui" >
            <button class="ui-control icon fas fa-eraser" data-action="resetInit" data-tooltip="CRAWLHELPER.carousel.reset-init"></button>
            <button class="ui-control icon fas fas fa-angles-left" data-action="previousRound" data-tooltip="CRAWLHELPER.carousel.round.previous"></button>
            <button class="ui-control icon fas fas fa-angle-left" data-action="previousTurn" data-tooltip="CRAWLHELPER.carousel.turn.previous"></button>
        </div>
    {{/if}}


{{/if}}
</div>