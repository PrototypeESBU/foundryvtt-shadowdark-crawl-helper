<div class="main-part">
{{#if crawlStarted}}

    {{#if isGM}}
        <div class="side-buttons">
            <ol>
                <li class="small" data-action="resetInit" data-tooltip="CRAWLHELPER.carousel.reset-init">
                    <i class="fas fa-eraser"></i>
                </li>
                <li class="small" data-action="previousRound" data-tooltip="CRAWLHELPER.carousel.round.previous">
                    <i class="fas fa-angles-left"></i>
                </li>
                <li data-action="previousTurn" data-tooltip="CRAWLHELPER.carousel.turn.previous">
                    <i class="fas fa-angle-left"></i>
                </li>
            </ol>
        </div>
    {{/if}}

    <div class="combatant-container shadowdark" style="{{containerStyle}}">
        {{#each combatants}}
            {{#if isDivider}}
                <div class="round-divider" style="order: {{order}}" data-combatant-id="{{id}}">
                    <div></div>
                    <span class="transition">{{round}}</span>
                    <div></div>
                </div>
            {{else}}
                    {{> combatant isGM=../isGM}}
            {{/if}}
        {{/each}}
    </div>


    <div class="side-buttons">
        <ol>
            <li class="small" data-action="rollAllInit" data-tooltip="CRAWLHELPER.carousel.roll-all" {{#unless unrolledInit}}style="color: #444"{{/unless}}>
                <i class="fas fa-dice-d20"></i>
            </li>
            {{#if isGM}}
            <li class="small" data-action="nextRound" data-tooltip="CRAWLHELPER.carousel.round.next">
                <i class="fas fa-angles-right"></i>
            </li>
            <li data-action="nextTurn" data-tooltip="CRAWLHELPER.carousel.turn.next">
                <i class="fas fa-angle-right"></i>
            </li>
            {{/if}}
        </ol>
    </div>


{{/if}}
</div>