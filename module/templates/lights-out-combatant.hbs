<div class="combatant {{styleClass}}" style="order: {{order}}" data-combatant-id="{{id}}" data-is-owner="{{isOwner}}">

    <div class="portrait">
        <img src="{{img}}" data-actor-id="{{actorId}}" data-combatant-id="{{id}}">
        <div class="overlay {{#unless overlay}}hidden{{/unless}}">
            {{#if masked}}
                <i class="fas fa-mask"></i>
            {{/if}}
            {{#if hidden}}
                <i class="fas fa-eye-slash"></i>
            {{/if}}
            {{#if defeated}}
                <i class="fas fa-skull"></i>
            {{/if}}
        </div>
    </div>

    <div class="character-info">
        <div class="character-info-wrapper">
            <div class="character-details">
                <div class="character-name">{{name}}</div>
            </div>
            <div class="character-health">
                <div class="bar-wrapper">
                    <div class="bar healthy {{system.type}}" style="width: calc({{barPercent}}% - 1px)"></div>
                    {{#if canView}}
                        <input type="text" class="current-health" data-value="{{hp.value}}" data-combatant-id="{{id}}"
                            value="{{hp.value}}" />
                        <span class="divider">/</span>
                        <input type="text" value="{{hp.max}}" disabled />
                    {{/if}}
                </div>
            </div>
        </div>
    </div>

    {{#if system.isDying}}
        <div class="death-timer">
            <i class="fa-solid fa-skull"></i>
            <i class="fa-solid fa-hourglass-half"></i>
            <span>
                {{#if system.dyingRounds}}
                    {{system.dyingRounds}}
                {{else}}
                    <i class="fa-solid fa-dice-d20" style="font-size:14px"></i>
                {{/if}}
            </span>
        </div>
    {{/if}}


    <div class="initiative">
        <div class="initiative-wrapper">
            {{#if initiativeSet}}
                {{initiative}}
            {{else if isOwner}}
                <a 
                    data-action="rollInitiative"
                    data-combatant-id="{{id}}"
                    data-tooltip="CRAWLHELPER.carousel.roll-init"
                >
                    <i class="fal fa-dice-d20"></i>
                </a>
            {{/if}}
        </div>
    </div>

</div>