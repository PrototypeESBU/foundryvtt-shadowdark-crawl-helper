<div class="shadowdark">
    {{#if encounter}}
    <h2 class="centered">Encounter!</h2>
    {{else}}
    <div class="centered"><h3>No Encounter</h3></div>
    {{/if}}
    <h3 style="font-family: 'Montserrat-Medium'">
        {{#if result}}
            Rolled: {{result}}
        {{else}}
            Instant 
        {{/if}}
    </h3> 
</div>