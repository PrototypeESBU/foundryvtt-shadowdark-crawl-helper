<div class="main-part faded-ui">
        <div class="danger">
            <label style="line-height: 2;">{{localize "CRAWLHELPER.danger.level"}}:</label>
            <select name="dangerLevel">
                {{selectOptions dangerIndex selected=dangerLevel}}
            </select>
        </div>

        <div class="button-bar">
            <button 
                class="ui-control icon fas fa-people-group {{#unless started}}disabled{{/unless}}" 
                {{#if started}}data-action="toggleParty"{{/if}}
                data-tooltip="CRAWLHELPER.gmtools.tooltip-add-party">
            </button>
            <button 
                class="ui-control icon fas fa-hat-wizard {{#unless started}}disabled{{/unless}}" 
                {{#if started}}data-action="toggleGameMaster"{{/if}}
                data-tooltip="CRAWLHELPER.gmtools.tooltip-add-gm">
                </button>
            <button 
                class="ui-control icon fas fa-dice" 
                data-action="triggerEncounterCheck" 
                data-tooltip="CRAWLHELPER.gmtools.tooltip-encounter-check">
                </button>
            <button 
                class="ui-control icon fas fa-bolt-lightning" 
                ata-action="triggerEncounter" 
                data-tooltip="CRAWLHELPER.gmtools.tooltip-encounter">
                </button>
            <button 
                class="ui-control icon fas fa-hourglass-half" 
                data-action="timePasses" 
                data-tooltip="CRAWLHELPER.gmtools.tooltip-time-passes">
                </button>
            <button 
                class="ui-control icon fas fa-rectangle-xmark {{#unless started}}disabled{{/unless}}" 
               {{#if started}}data-action="endCrawling"{{/if}} 
                data-tooltip="CRAWLHELPER.gmtools.tooltip-end-tracker">
            </button>
        </div>

        <div class="encounter-table" data-drop="true">
            {{#if encounterTable}}
                <a style="flex:0;" data-action="clearRollTable" data-tooltip="CRAWLHELPER.gmtools.table-remove"><i class="fas fa-trash"></i></a>
                <label><a data-link data-uuid="{{encounterTable.uuid}}">{{encounterTable.name}}</a></label>
            {{else}}
                <span>{{localize "CRAWLHELPER.gmtools.drop"}}</span>
            {{/if}}
        </div>
</div>